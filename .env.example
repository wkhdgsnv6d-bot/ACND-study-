# Ascend Business Mastery — environment variables
#
# Copy to `.env.local` and fill in. `.env.local` is gitignored and must stay
# that way: it holds credentials to a database containing real client
# information.
#
# Phase 1 (design system, content pipeline, engines) needs none of these.
# `npm run dev`, `npm run build` and `npm test` all work with this file absent.

# ---------------------------------------------------------------------------
# Supabase — required from Phase 2 onward
# ---------------------------------------------------------------------------
# Create a project at https://supabase.com/dashboard, then find these under
# Project Settings → API.

# Safe to expose to the browser. Every table is protected by row-level security,
# so this key alone grants access to nothing without a valid session.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses row-level security entirely.
# Never import this into a client component, never prefix it with NEXT_PUBLIC_,
# never paste it into a chat window or a screenshot. Used only by migration and
# admin scripts run from your machine or CI.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by Drizzle for migrations only.
# Project Settings → Database → Connection string (use the pooled URI for
# application access and the direct URI for migrations).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Used to build auth redirect URLs. http://localhost:3000 in development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI Study Assistant — required from Phase 10 onward
# ---------------------------------------------------------------------------
# The assistant UI ships before this key exists and degrades to a clear
# "not configured" state rather than erroring.
ANTHROPIC_API_KEY=
